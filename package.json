{
  "name": "lolabot-factory",
  "version": "0.1.2",
  "private": true,
  "description": "Build your AI employee in 60 seconds. Pick personality + skills → get installable agent.",
  "scripts": {
    "dev": "next dev --port 3000",
    "build": "next build",
    "start": "next start --port 3000",
    "lint": "next lint",
